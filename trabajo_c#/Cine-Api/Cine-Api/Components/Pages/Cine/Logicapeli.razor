@using System.Net.Http.Json
@using Cine_Api.Components.Pages.Cine.classe

@inject HttpClient Http

@code
{
    [Parameter]
    public EventCallback<List<Pelicula>> OnPeliculasCargadas { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var resultado = await Http.GetFromJsonAsync<List<Pelicula>>(
                "api/Pelicula"
            );

            if (resultado != null)
            {
                await OnPeliculasCargadas.InvokeAsync(resultado);
            }
        }
        catch (Exception error)
        {
            Console.WriteLine(error.Message);
        }
    }


}